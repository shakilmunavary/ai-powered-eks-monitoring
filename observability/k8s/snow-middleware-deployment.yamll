apiVersion: apps/v1
kind: Deployment
metadata:
  name: snow-middleware
spec:
  replicas: 1
  selector:
    matchLabels:
      app: snow-middleware
  template:
    metadata:
      labels:
        app: snow-middleware
    spec:
      containers:
      - name: snow
        image: shakilmunavary/snow-middleware:latest   # 👈 Docker Hub image
        ports:
        - containerPort: 5000
        env:
        - name: SNOW_URL
          value: "https://your-instance.service-now.com"
        - name: SNOW_USER
          value: "your_user"
        - name: SNOW_PASS
          value: "your_pass"
---
apiVersion: v1
kind: Service
metadata:
  name: snow-middleware
spec:
  selector:
    app: snow-middleware
  ports:
  - port: 5000
    targetPort: 5000
